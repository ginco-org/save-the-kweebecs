$C = "../Common.ui";

$C.@DecoratedContainer {
    Anchor: (Width: 560, Left: 40);
    Padding: (Top: 90, Bottom: 120);

    #Title {
        Label #ShopTitle {
            Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
            Padding: (Horizontal: 19);
            Text: "Shop";
        }
    }

    #Content {
        LayoutMode: Top;
        Padding: (Horizontal: 15, Vertical: 3);

        Group #HeaderInfo {
            LayoutMode: Left;
            Anchor: (Height: 30);
            Padding: (Left: 8, Right: 8, Bottom: 4);

            Group #BalanceArea {
                LayoutMode: Left;
                Anchor: (Height: 30);

                Label #BalanceTitle {
                    Style: (FontSize: 15, TextColor: #8a9aaa, VerticalAlignment: Center);
                    Text: "Your Balance: ";
                }

                Label #PlayerBalance {
                    Style: (FontSize: 16, TextColor: #f0c040, RenderBold: true, VerticalAlignment: Center);
                    Text: "0 Coins";
                }
            }
        }

        Group #Divider {
            Anchor: (Height: 2);
            Background: #19252F;
            Padding: (Bottom: 6);
        }

        Group #ItemsGridContainer {
            Anchor: (Width: 500, Height: 360);
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
            Padding: (Top: 8, Left: 3, Right: 3, Bottom: 30);
            LayoutMode: TopScrolling;

            Group #ItemsGrid {
                LayoutMode: Top;
            }
        }
    }
}

$C.@BackButton {
}
